datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Attendance {
  id             String   @id @default(cuid())
  date           DateTime @unique
  dayType        String
  assistantCount Int
  observation    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([date])
  @@index([dayType])
}
